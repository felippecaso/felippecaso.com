{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "felippecaso",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "previews": {},
  "routes": [
    { "pattern": "www.felippecaso.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
